# Variables de entorno locales
.env

# Backups de base de datos (contienen datos reales de huéspedes — nunca al repo)
backups/

# Archivos temporales del sistema
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Dependencias si después usas Composer o Node
vendor/
node_modules/

# EXCEPCIÓN: assets self-hosted de la PWA offline (Font Awesome, Tailwind,
# Chart.js, SweetAlert2, fuentes...). Son parte de la app y DEBEN versionarse
# para que producción y clones nuevos no queden sin íconos/estilos.
!/src/public_html/vendor/
!/src/public_html/vendor/**

# Archivos temporales de editores
.vscode/
.idea/

# Archivos de cache
.cache/
tmp/
temp/

# No ignorar archivos plantilla
!.env.example

# Archivos locales sensibles o de diagnostico
_local_quarantine_sensitive/
/src/public_html/__qa_*.php
/src/public_html/qa_*.php
/src/public_html/debug_*.php

# Fase 0.5 - artefactos locales y operativos
backups/
src/app/uploads/
src/storage/documentos/
src/storage/reportes/
# Uploads generados por hoteles/usuarios: nunca versionarlos. Se conservan
# solamente la proteccion Apache y las imagenes default propias de la app.
/src/public_html/uploads/**
!/src/public_html/uploads/.htaccess
!/src/public_html/uploads/habitaciones/
!/src/public_html/uploads/habitaciones/defaults/
!/src/public_html/uploads/habitaciones/defaults/**
*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.tmp
*.temp

# Migraciones SQL versionadas del proyecto
!migrations/*.sql

# Tooling de migracion legacy: el SQL ES el codigo fuente (la version de Los
# Cedros nunca viajo por git y hubo que reconstruirla desde cero en otra PC)
!tools/migracion_sannicolas/*.sql

# Paquetes locales de despliegue
dist/

# Configuración personal de Claude Code
.claude/settings.local.json
.claude/skills-disabled/

# Fotos de identificacion de huespedes (PII - nunca al repo)
src/storage/checkin_ids/

# Config local de preview de Claude (rutas por maquina)
.claude/launch.json

# Excepcion: schema sin datos (fuente de la BD de prueba y del CI)
!src/database/schema.sql

# Snapshots one-shot para sesiones de diseno externas (historico, no fuente)
exports/
