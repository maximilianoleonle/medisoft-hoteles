# Uploads: servir solo archivos estaticos seguros.
Options -Indexes -ExecCGI
AddHandler cgi-script .php .php3 .php4 .php5 .phtml .pl .py .jsp .asp .sh .cgi

<FilesMatch "\.(php|php[0-9]?|phtml|phar|pl|py|jsp|asp|sh|cgi|exe|bat|cmd|com|scr)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf)$">
    Require all granted
</FilesMatch>
