APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=false

DB_HOST=db
DB_PORT=3306
DB_NAME=medisoft_hoteles
DB_USER=medisoft_user
DB_PASS=change_me
DB_ROOT_PASS=change_me

WHATSAPP_ID_INSTANCE=
WHATSAPP_API_TOKEN=
WHATSAPP_DESTINATION=
WHATSAPP_API_HOST=https://api.green-api.com
WHATSAPP_SEND_ENABLED=false

APP_WHATSAPP_ID_INSTANCE=
APP_WHATSAPP_API_TOKEN=
APP_WHATSAPP_DESTINATION=
APP_WHATSAPP_API_HOST=https://api.green-api.com
APP_WHATSAPP_SEND_ENABLED=false

APP_PORT=8080
MYSQL_EXTERNAL_PORT=3307
PHPMYADMIN_PORT=8081

# Web Push / PWA notifications
PWA_VAPID_PUBLIC_KEY=
PWA_VAPID_PRIVATE_KEY=
PWA_VAPID_SUBJECT=mailto:soporte@medisoft.mx

# Motor de reservas: cifrado AES-256-GCM de credenciales de pasarela.
# Generar por instalacion: openssl rand -base64 32
# (si se pierde la llave hay que re-capturar las llaves de pasarela de cada hotel)
MOTOR_PASARELA_KEY=

# Asesor inteligente (bloque ia_ejecutiva): llave del API de Anthropic
# (console.anthropic.com -> API Keys). Medisoft paga el API y revende el bloque.
ANTHROPIC_API_KEY=

# NOTA Docker: tras editar .env hay que RECREAR el contenedor
# (docker compose up -d app), no solo reiniciarlo — el env se inyecta al crear.

# Errores SQL estrictos: true = una query rota lanza excepcion en vez de
# disfrazarse de "sin datos". Recomendado SIEMPRE en true.
DB_STRICT_ERRORS=true

# Backup offsite: destino rclone (ej. b2:medisoft-backups). Vacio = solo backup local.
BACKUP_RCLONE_REMOTE=

# Proxies confiables (IPs o CIDRs separados por coma). Solo si REMOTE_ADDR cae
# aqui se honran X-Forwarded-For/-Proto (IP real + cookies Secure detras de
# Caddy). Vacio = no confiar en ningun proxy (SOLO correcto en dev con acceso
# directo al contenedor, sin reverse proxy delante).
#
# IMPORTANTE (seguridad): detras de un reverse proxy (Caddy/nginx) esta
# variable DEBE definirse con la IP/CIDR del proxy. Si se deja vacia en ese
# escenario, PHP vera la IP del PROXY para TODOS los visitantes y en silencio:
#   - el rate-limit de login colapsa a una sola IP (cualquier atacante puede
#     agotar el tope global y bloquear el login de todo el mundo, y a la vez
#     el bloqueo por IP real deja de servir);
#   - login_intentos y la auditoria registran la IP del proxy, no la real;
#   - las cookies pierden Secure/HSTS porque PHP no detecta HTTPS.
# El login registra una ADVERTENCIA en error_log si detecta X-Forwarded-For
# con esta variable vacia — si aparece, hay que configurarla.
#
# En docker-compose.prod.yml el contenedor caddy vive en la red del compose:
# usar la subred de esa red o la IP fija del servicio. Ejemplo (subred tipica
# de la red docker del compose; verificar con `docker network inspect`):
# TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

# Interfaz donde el compose de DEV publica app/MySQL/phpMyAdmin. Default
# 127.0.0.1 = solo esta maquina. Para probar desde el telefono u otra PC de
# la LAN, poner DEV_BIND=0.0.0.0 DELIBERADAMENTE y regresarlo al terminar.
DEV_BIND=127.0.0.1

# QA funcional de bloques comerciales (tools/test_bloques_funcional.sh).
# Usar solo un hotel/usuario de prueba; nunca reutilizar credenciales reales.
QA_BASE_URL=http://localhost:8080
QA_HOTEL_SLUG=
QA_HOTEL_ID=
QA_BLOQUES_USER=
QA_BLOQUES_PASSWORD=
QA_DB_CONTAINER=medisoft_hoteles_db
QA_ALLOW_REMOTE=0
