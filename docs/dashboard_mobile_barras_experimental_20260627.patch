+$m_occ_bars = [];
+
+foreach (array_slice($weekly_line_rows, -7) as $row) {
+    $bar_pct = min(100, max(0, (float)($row['pct'] ?? 0)));
+    $m_occ_bars[] = [
+        'label' => (string)($row['dia'] ?? '-'),
+        'height' => max(18, $bar_pct),
+        'value' => max(0, (int)($row['ocupadas'] ?? 0)),
+        'is_today' => !empty($row['es_hoy']),
+        'is_peak' => !empty($row['es_pico']),
+    ];
+}
+
+if (empty($m_occ_bars)) {
+    $m_occ_bars[] = [
+        'label' => 'Hoy',
+        'height' => max(18, $m_occupancy_width),
+        'value' => $habitaciones_ocupadas,
+        'is_today' => true,
+        'is_peak' => true,
+    ];
+}
+
+// Orden fijo de la semana (Dom→Sáb): el día de hoy ya no se va al extremo derecho.
+$m_occ_day_order = ['Dom' => 0, 'Lun' => 1, 'Mar' => 2, 'Mié' => 3, 'Jue' => 4, 'Vie' => 5, 'Sáb' => 6];
+usort($m_occ_bars, static function ($a, $b) use ($m_occ_day_order) {
+    return ($m_occ_day_order[$a['label']] ?? 99) <=> ($m_occ_day_order[$b['label']] ?? 99);
+});
+
+// "Hoy" del card = mismo dato que su barra de hoy (coherente con la gráfica de la semana).
+$m_today_occupied = $habitaciones_ocupadas;
+foreach ($m_occ_bars as $__bar_today) {
+    if (!empty($__bar_today['is_today'])) {
+        $m_today_occupied = (int)$__bar_today['value'];
+        break;
+    }
+}
+$m_today_available = max(0, $weekly_total_active - $m_today_occupied);
+$m_today_pct = $weekly_total_active > 0
