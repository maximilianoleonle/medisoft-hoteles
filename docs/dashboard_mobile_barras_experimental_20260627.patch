+    : 0;
+$m_occ_today_pct_label = dashboard_percent_text($m_today_pct);
+
+$m_occ_delta_pct = $m_today_pct - $m_occ_avg_pct;
+$m_occ_delta_label = ($m_occ_delta_pct >= 0 ? '+' : '') . dashboard_percent_text($m_occ_delta_pct);
+$m_occ_delta_class = $m_occ_delta_pct >= 0 ? 'is-up' : 'is-down';
